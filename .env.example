# Leave ELEVENLABS_API_KEY blank to use free offline text-to-speech instead.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here

# How often the agent polls sensors (seconds)
POLL_INTERVAL_SECONDS=your_poll_interval_seconds_here

# Reminder timers (seconds) - shortened for demo purposes.
# For real use, set these much higher, e.g. 14400 for every 4 hours.
PIPE_CLEAN_INTERVAL_SECONDS=your_pipe_clean_interval_seconds_here
MAINTENANCE_INTERVAL_SECONDS=your_maintenance_interval_seconds_here

# Safety thresholds
NOZZLE_TEMP_MIN_C=your_nozzle_temp_min_c_here
NOZZLE_TEMP_MAX_C=your_nozzle_temp_max_c_here
BED_TEMP_MAX_C=your_bed_temp_max_c_here
HEIGHT_TOLERANCE_MM=your_height_tolerance_mm_here
MATERIAL_FLOW_MIN_PERCENT=your_material_flow_min_percent_here

# Minimum seconds between repeats of the same warning
ALERT_COOLDOWN_SECONDS=your_alert_cooldown_seconds_here

# --- Camera source: "usb" (local UVC camera) or "rtsp" (EZVIZ / IP camera) ---
CAMERA_SOURCE=your_camera_source_here

# --- EZVIZ / RTSP IP camera (used when CAMERA_SOURCE=rtsp) ---
# NEVER commit real credentials. .env is gitignored; .env.example must stay blank.
# Option A: set the pieces and let the URL be built.
CAMERA_IP=your_camera_ip_here
CAMERA_USERNAME=your_camera_username_here
# EZVIZ: the 6-character VERIFICATION CODE printed on the camera label.
CAMERA_PASSWORD=your_camera_password_here
CAMERA_RTSP_PORT=your_camera_rtsp_port_here
# EZVIZ main stream: /H.264/ch1/main/av_stream
# EZVIZ sub stream (lower latency, smaller): /H.264/ch1/sub/av_stream
CAMERA_RTSP_PATH=your_camera_rtsp_path_here
# Leave CAMERA_RTSP_PATH at the default and the app PROBES the known EZVIZ /
# Hikvision stream paths automatically, then tells you which one worked so you
# can pin it here.
# Option B: override everything with a full URL (RTSP_URL also accepted).
CAMERA_RTSP_URL=your_camera_rtsp_url_here
# RTSP connection timeout (seconds).
CAMERA_RTSP_TIMEOUT_SECONDS=your_camera_rtsp_timeout_seconds_here
# tcp is far more reliable than udp over Wi-Fi/LAN.
CAMERA_RTSP_TRANSPORT=your_camera_rtsp_transport_here
# Auto-reconnect behaviour for network cameras (0 attempts = retry forever).
CAMERA_RECONNECT_DELAY_SECONDS=your_camera_reconnect_delay_seconds_here
CAMERA_MAX_RECONNECT_ATTEMPTS=your_camera_max_reconnect_attempts_here
CAMERA_READ_FAILURE_LIMIT=your_camera_read_failure_limit_here

# --- Camera (USB) ---
CAMERA_INDEX=your_camera_index_here
# 640x480 @ 30 is the safest mode; almost every USB/UVC camera supports it.
# The opener falls back automatically if a requested mode isn't supported,
# and prefers the modes the camera actually advertises.
CAMERA_WIDTH=your_camera_width_here
CAMERA_HEIGHT=your_camera_height_here
CAMERA_FPS=your_camera_fps_here
# Set to false to run the vision pipeline without opening a window.
SHOW_CAMERA_WINDOW=your_show_camera_window_here

# Capture backend: auto | dshow | msmf | any
# "auto" tries DirectShow FIRST on Windows -- external USB cameras often open
# under Media Foundation (MSMF) but then fail to deliver frames.
CAMERA_BACKEND=your_camera_backend_here

# Prefer the camera whose name contains this text, so an external USB camera is
# chosen instead of the built-in one even if indexes shuffle between reboots.
# e.g. CAMERA_NAME_HINT=Sonix   (needs: pip install pygrabber)
CAMERA_NAME_HINT=your_camera_name_hint_here

# If the configured index doesn't deliver frames, scan other indexes.
CAMERA_AUTO_SCAN=your_camera_auto_scan_here
CAMERA_SCAN_MAX_INDEX=your_camera_scan_max_index_here

# --- Vision calibration (REQUIRED for millimetre measurements) ---
# This is NOT a guess-able value: it depends on your camera's lens, resolution,
# and its distance to the part. To calibrate: put an object of known width in
# the frame at the same distance as the print, count how many pixels it spans,
# and divide by its width in mm.  e.g. a 20 mm block spanning 200 px -> 10.0
# Leave blank to report measurements in pixels only (nothing is guessed).
PIXELS_PER_MM=your_pixels_per_mm_here

# Minimum layer bands that must be detected before layer numbers are trusted.
MIN_LAYER_BOUNDARIES=your_min_layer_boundaries_here
# How many recent layer-width samples feed the increasing/decreasing trend.
LAYER_WIDTH_HISTORY=your_layer_width_history_here

# --- Vision alert thresholds (only used when a real measurement exists) ---
# Kelvin6K is large-format: beads are ~10 mm, not 0.4 mm like desktop FDM.
# Set these to YOUR machine's real range or every layer reads ABNORMAL.
LAYER_WIDTH_MIN_MM=your_layer_width_min_mm_here
LAYER_WIDTH_MAX_MM=your_layer_width_max_mm_here
PRINT_QUALITY_MIN_PERCENT=your_print_quality_min_percent_here

# --- Region of interest (pixels in the raw frame; all 0 = whole frame) ---
# Restrict analysis to where material is actually deposited.
ROI_X=your_roi_x_here
ROI_Y=your_roi_y_here
ROI_WIDTH=your_roi_width_here
ROI_HEIGHT=your_roi_height_here

# --- Print-status detection ---
# Analyse every Nth frame (display stays smooth, CPU stays sane).
FRAME_SKIP=your_frame_skip_here
# Minimum confidence before a layer reading is acted on.
LAYER_CONFIDENCE_THRESHOLD=your_layer_confidence_threshold_here
# Temporal debouncing: consecutive analysed frames that must agree before the
# state flips, so one bad frame never changes the machine state.
LAYER_DETECT_FRAMES=your_layer_detect_frames_here
LAYER_MISSING_FRAMES=your_layer_missing_frames_here
# "Printing" is inferred from frame-to-frame change in the ROI until a real
# machine status link exists.
# Tune by watching "Motion (ROI)" on the live dashboard: note it idle vs
# printing, then set this between the two.
PRINT_MOTION_THRESHOLD=your_print_motion_threshold_here
PRINT_ACTIVE_FRAMES=your_print_active_frames_here
PRINT_IDLE_FRAMES=your_print_idle_frames_here

# --- Database (persistent machine state / print jobs) ---
DATABASE_PATH=your_database_path_here
# Machine state older than this is treated as stale, never reported as current.
MACHINE_STATE_MAX_AGE_SECONDS=your_machine_state_max_age_seconds_here
# Below this confidence the assistant says the measurement is uncertain.
MIN_REPORT_CONFIDENCE=your_min_report_confidence_here
# How often the vision loop writes a machine_state row (seconds).
STATE_PERSIST_INTERVAL_SECONDS=your_state_persist_interval_seconds_here

# --- RAG (manuals, SOPs, troubleshooting docs) ---
RAG_INDEX_DIR=your_rag_index_dir_here
RAG_DOCS_DIR=your_rag_docs_dir_here
RAG_CHUNK_SIZE=your_rag_chunk_size_here
RAG_CHUNK_OVERLAP=your_rag_chunk_overlap_here
RAG_TOP_K=your_rag_top_k_here
# Below this score, retrieval reports "not found in the documentation".
RAG_MIN_SCORE=your_rag_min_score_here
GEMINI_EMBEDDING_MODEL=your_gemini_embedding_model_here
GEMINI_EMBED_MODEL=your_gemini_embed_model_here

# --- Voice Q&A (two-way interaction) ---
# Google Gemini powers the conversational answers.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=your_gemini_model_here

# --- Anthropic (OPTIONAL: only for the alternative backend / check_api_key.py) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=your_anthropic_model_here

# Only required for identity-linked API keys (created via SSO/user identity
# in the Console). Leave blank first -- if your key needs it, the API will
# say so with a 400 error, and check_api_key.py will explain how to find it.
ANTHROPIC_WORKSPACE_ID=your_anthropic_workspace_id_here

# Set false to run monitoring without the voice assistant.
VOICE_ENABLED=your_voice_enabled_here

# Local speech-to-text model size (faster-whisper): tiny | base | small | medium
# For Hindi/Hinglish questions use "small" or "medium" -- tiny/base handle
# non-English poorly.
WHISPER_MODEL_SIZE=your_whisper_model_size_here
# "auto" detects the language (needed for "Print chal raha hai kya?").
# Set "en" to force English only.
WHISPER_LANGUAGE=your_whisper_language_here

# --- Logging ---
LOG_LEVEL=your_log_level_here
# Optional rotating log file, e.g. kelvin6k.log. Blank = console only.
LOG_FILE=your_log_file_here

# How many seconds to record after the operator presses Enter to ask a question
MAX_RECORD_SECONDS=your_max_record_seconds_here
